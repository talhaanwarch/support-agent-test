# Copy to .env and fill in. .env is git-ignored.

# AcruxCore API. Cloud: https://api.acruxcore.com/api/v1 — self-hosted: http://localhost:3001/api/v1
ACRUXCORE_BASE_URL=
# Account & keys -> New key
ACRUXCORE_API_KEY=

# Provider keys, used once by 01_setup.py to create the gateway credentials
OPENROUTER_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# The model under test and the judge, as registered under Gateway -> Models
AGENT_MODEL=openai/gpt-6-luna
JUDGE_MODEL=glm-5.3
